---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.svelte';
import ResourceSkills from '../components/ResourceSkills.svelte';
import Footer from '../components/Footer.svelte';

const title = 'Agent Skills, Prompts & Diagnostic Resources — iberi22';
const description =
  'Agent-ready & human-friendly library of deterministic skills, architecture prompts, and pre-meet diagnostic tools for coding agents (Jules, Claude Code, Hermes, OpenCode). Copy raw Markdown directly or inspect canonical sources on GitHub.';
---

<Layout title={title} description={description}>
  <Nav client:load />
  <main class="pt-16">
    <ResourceSkills client:load />
  </main>
  <Footer client:load />
</Layout>
