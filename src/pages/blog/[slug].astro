---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.svelte';
import Footer from '../../components/Footer.svelte';
import { baseUrl, siteUrl } from '../../lib/baseUrl';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Reading time: prefer frontmatter value, else estimate from body (~200 wpm)
const bodyText = typeof post.body === 'string' ? post.body : '';
const bodyWords = bodyText.split(/\s+/).length;
const readingTime = post.data.readingTime ?? Math.max(1, Math.round(bodyWords / 200));
const canonicalHref = post.data.canonical ?? siteUrl(`blog/${post.id}/`);
---

<Layout
  title={`${post.data.title} | Brahyan Belalcázar (iberi22)`}
  description={post.data.description ?? (post.data.excerpt || post.data.title + ' — Arquitectura, orquestación agéntica y desarrollo de software por Brahyan Belalcázar.')}
  article={true}
  publishDate={post.data.date}
  articlePath={`blog/${post.id}/`}
  articleTitle={post.data.title}
  tags={post.data.tags}
>
  <Nav client:load />
  <main class="min-h-screen px-6 pt-32 pb-24">
    <article class="max-w-4xl mx-auto">
      <div class="mb-12 border-b border-white/10 pb-8">
        <a href={baseUrl('blog/')} class="text-accent text-xs font-mono tracking-widest uppercase mb-6 inline-flex items-center gap-1 hover:underline">
          ← Volver a artículos
        </a>
        <div class="flex items-center gap-4 text-xs font-mono text-text-muted mb-4 mt-2">
          <span>{post.data.date}</span>
          <span>·</span>
          <span>{readingTime} min de lectura</span>
          <span>·</span>
          <span>Arquitectura Agéntica</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-text-primary mb-6 leading-tight">
          {post.data.title}
        </h1>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="text-xs font-mono px-3 py-1 rounded bg-white/5 text-accent border border-accent/20">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      <div class="markdown-body prose prose-invert max-w-none text-text-primary">
        <Content />
      </div>

      <!-- Social Share Bar -->
      <div class="mt-14 p-6 rounded-xl border border-white/10 bg-bg-surface-dark/80 backdrop-blur flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-sm font-mono text-text-muted">
          <span class="text-accent font-bold">Compartir artículo:</span>
        </div>
        <div class="flex items-center gap-3">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title + ' por @iberi22')}&url=${encodeURIComponent(canonicalHref)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2 rounded-lg bg-black border border-white/15 text-white text-xs font-mono font-bold hover:border-accent hover:text-accent transition-all duration-200 cursor-pointer shadow-sm hover:shadow-accent/20"
            title="Compartir en X (Twitter)"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span>X (Twitter)</span>
          </a>

          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalHref)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2 rounded-lg bg-[#0077B5]/10 border border-[#0077B5]/40 text-[#0077B5] hover:bg-[#0077B5]/20 hover:text-white text-xs font-mono font-bold transition-all duration-200 cursor-pointer shadow-sm"
            title="Compartir en LinkedIn"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.45 1.45 0 0 0 1.45-1.45 1.45 1.45 0 0 0-1.45-1.45 1.45 1.45 0 0 0-1.45 1.45 1.45 1.45 0 0 0 1.45 1.45m1.37 9.74v-8.37H5.09v8.37z"/>
            </svg>
            <span>LinkedIn</span>
          </a>

          <button
            id="copy-link-btn"
            class="flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-text-muted hover:text-white hover:border-white/30 text-xs font-mono transition-all duration-200 cursor-pointer"
            title="Copiar enlace"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span id="copy-text">Copiar link</span>
          </button>
        </div>
      </div>

      <script>
        const copyBtn = document.getElementById('copy-link-btn');
        const copyText = document.getElementById('copy-text');
        if (copyBtn && copyText) {
          copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(window.location.href);
            copyText.textContent = '¡Copiado!';
            setTimeout(() => {
              copyText.textContent = 'Copiar link';
            }, 2000);
          });
        }
      </script>

      <div class="mt-16 pt-8 border-t border-white/10 flex justify-between items-center">
        <a href={baseUrl('blog/')} class="btn-secondary text-sm">
          ← Ver todos los artículos
        </a>
        <a href={baseUrl('agenda/')} class="btn-primary text-sm">
          Agendar sesión técnica →
        </a>
      </div>
    </article>
  </main>
  <Footer client:load />
</Layout>

<style is:global>
  .markdown-body h1,
  .markdown-body h2,
  .markdown-body h3,
  .markdown-body h4 {
    color: var(--color-text-primary);
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .markdown-body h2 {
    font-size: 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.5rem;
    color: var(--color-accent);
  }
  .markdown-body h3 {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
  }
  .markdown-body p {
    color: #d1d5db;
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .markdown-body ul,
  .markdown-body ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: #d1d5db;
  }
  .markdown-body li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .markdown-body pre {
    background: #0d0d0e !important;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-family: var(--font-fira);
    font-size: 0.875rem;
  }
  .markdown-body code {
    font-family: var(--font-fira);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.875em;
    color: #67e8f9;
  }
  .markdown-body pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }
  .markdown-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    overflow-x: auto;
    display: table;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .markdown-body th {
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--color-accent);
    font-weight: 700;
    text-align: left;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-fira);
  }
  .markdown-body td {
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d1d5db;
    line-height: 1.6;
  }
  .markdown-body tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.02);
  }
  .markdown-body tr:hover {
    background-color: rgba(16, 185, 129, 0.05);
  }
  .markdown-body hr {
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 2.5rem 0;
  }
  .markdown-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .markdown-body blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
