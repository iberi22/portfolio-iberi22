---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.svelte';
import Footer from '../../components/Footer.svelte';

export async function getStaticPaths() {
  return [];
}
---

<Layout>
  <Nav client:load />
  <main class="min-h-screen flex items-center justify-center px-6 pt-24">
    <section class="max-w-2xl mx-auto text-center">
      <span class="text-accent text-sm tracking-widest mb-4 block"># blog</span>
      <h1 class="section-title">
        Contenido no disponible
      </h1>
      <p class="text-text-muted text-lg mt-4 leading-relaxed">
        Este espacio se mantiene deshabilitado hasta que exista contenido real.
      </p>
    </section>
  </main>
  <Footer client:load />
</Layout>
