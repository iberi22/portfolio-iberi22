---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.svelte';
import ResourceSimulator from '../components/ResourceSimulator.svelte';
import Footer from '../components/Footer.svelte';

const description =
  'Herramienta gratuita 100% serverless para simular las 5 mejores configuraciones de arquitectura agéntica (Costo vs. Velocidad) y generar prompts maestros y custom skills adaptados a tu hardware.';
---

<Layout title="Simulador de Recursos & Generador de Skills (Gratis) — iberi22" description={description}>
  <Nav client:load />
  <main class="pt-32 pb-24 px-6 max-w-6xl mx-auto">
    <ResourceSimulator client:load />
  </main>
  <Footer client:load />
</Layout>
