---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.svelte';
import BlogSection from '../components/BlogSection.svelte';
import Footer from '../components/Footer.svelte';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog')).map((post) => ({
  slug: post.id,
  title: post.data.title,
  excerpt: post.data.excerpt,
  date: post.data.date,
  tags: post.data.tags,
  draft: post.data.draft,
}));
---

<Layout>
  <Nav client:load />
  <main class="pt-24">
    <div class="py-16 px-6 text-center">
      <span class="text-accent text-sm tracking-widest mb-4 block"># blog</span>
      <h1 class="section-title">
        <span class="text-accent">Blog</span>
      </h1>
      <p class="text-text-muted text-lg mt-4 max-w-2xl mx-auto">
        Deep dives into systems architecture, AI orchestration, and engineering.
        Posts are autogenerated via the SWAL pipeline as projects mature.
      </p>
    </div>
    <BlogSection client:load posts={blogPosts} />
  </main>
  <Footer client:load />
</Layout>
